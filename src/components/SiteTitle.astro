---
// Override of Starlight's SiteTitle: the site name as text, a pill that says the site
// is not the publisher's, and links to the machine-readable outputs of the current page.
// The official docs show the Stitch wordmark and a "BETA" pill here; this site borrows the
// layout, not the logo. The bracketed key hints before the links are drawn by CSS
// (`[data-key]::before`), so they never reach the text an agent extracts from the page.
import { LABELS, localeOf, pageId, mdPath, llmsPath, withBase } from '../lib/site.mjs';

const { siteTitle, siteTitleHref, entry } = Astro.locals.starlightRoute;
const locale = localeOf(entry.id);
const t = LABELS[locale.lang];
const links = [
	...(entry.data.lastVerified ? [{ key: 'M', label: 'Markdown', href: withBase(mdPath(pageId(entry.id))) }] : []),
	{ key: 'L', label: 'llms.txt', href: withBase(llmsPath(locale)) },
	{ key: 'J', label: 'index.json', href: withBase('/index.json') },
];
---

<a href={siteTitleHref} class="site-title" translate="no">
	<span class="name">{siteTitle}</span>
	<span class="pill">{t.unofficial}</span>
</a>
<nav class="outputs" aria-label={t.formats}>
	{links.map((link) => <a href={link.href} data-key={link.key} aria-keyshortcuts={link.key.toLowerCase()}>{link.label}</a>)}
</nav>

<script is:inline>
	// Single-key shortcuts for the links above. Ignored while typing or with modifier keys.
	document.addEventListener('keydown', (event) => {
		if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey) return;
		const target = event.target;
		if (target instanceof HTMLElement) {
			if (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
		}
		if (document.querySelector('dialog[open]')) return;
		const link = document.querySelector(`nav.outputs a[data-key="${event.key.toUpperCase()}"]`);
		if (link instanceof HTMLAnchorElement) link.click();
	});
</script>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
		color: var(--sl-color-white);
		font-family: var(--st-font-display);
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	.pill {
		border: 1px solid currentColor;
		border-radius: 999px;
		padding: 0.1rem 0.5rem;
		font-family: var(--sl-font);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}
	.outputs {
		display: none;
		gap: 1.25rem;
		margin-inline-start: 1.5rem;
		font-size: 0.8125rem;
		font-weight: 500;
		white-space: nowrap;
	}
	@media (min-width: 72rem) {
		.outputs {
			display: flex;
			align-items: center;
		}
	}
	.outputs a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.outputs a::before {
		content: '[' attr(data-key) '] ';
		color: var(--sl-color-text-accent);
		font-family: var(--sl-font-mono);
	}
	.outputs a:hover,
	.outputs a:focus-visible {
		color: var(--sl-color-white);
	}
	@media (max-width: 24rem) {
		.site-title {
			font-size: 1.25rem;
		}
	}
</style>
