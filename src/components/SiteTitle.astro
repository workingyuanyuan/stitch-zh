---
// Override of Starlight's SiteTitle: the site name as text, a pill that says the site
// is not the publisher's, and a link to the first page of each section (the section tabs
// of the sidebar, `SECTIONS` in src/lib/site.mjs), in the sidebar's order and labels.
// The official docs show the Stitch wordmark and a "BETA" pill here; this site borrows the
// layout, not the logo. The Markdown twin, llms.txt and index.json are linked from the
// page notes (MarkdownContent.astro).
import { SECTIONS, LABELS, localeOf, pageId, sectionPages, sectionOf, htmlPath, withBase } from '../lib/site.mjs';

const { siteTitle, siteTitleHref, entry } = Astro.locals.starlightRoute;
const t = LABELS[localeOf(entry.id).lang];
// The sidebar of a page holds only its own section (src/routeData.ts), so the sections
// come from SECTIONS, as the section tabs in the Sidebar override do.
const current = sectionOf(pageId(entry.id));
---

<a href={siteTitleHref} class="site-title" translate="no">
	<span class="name">{siteTitle}</span>
	<span class="pill">{t.unofficial}</span>
</a>
<nav class="sections" aria-label={t.sections}>
	{
		SECTIONS.map((section) => (
			<a href={withBase(htmlPath(sectionPages(section)[0]))} aria-current={section === current ? 'true' : undefined}>
				{section.label}
			</a>
		))
	}
</nav>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
		color: var(--sl-color-white);
		font-family: var(--st-font-display);
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	/* A disc in the aurora colours of the home page's prompt ring before the name. */
	.site-title::before {
		content: '';
		flex: none;
		width: 0.6em;
		height: 0.6em;
		border-radius: 50%;
		background: conic-gradient(from 200deg, #9154e7, #6056f0, #40d9c6, #4285f4, #9154e7);
	}
	.pill {
		border: 1px solid currentColor;
		border-radius: 999px;
		padding: 0.1rem 0.5rem;
		font-family: var(--sl-font);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}
	.sections {
		display: none;
		gap: 1.25rem;
		margin-inline-start: 1.5rem;
		font-size: 0.8125rem;
		font-weight: 500;
		white-space: nowrap;
	}
	@media (min-width: 72rem) {
		.sections {
			display: flex;
			align-items: center;
		}
	}
	.sections a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	/* The section of the current page, as the section tabs mark it. */
	.sections a[aria-current] {
		color: var(--sl-color-white);
	}
	.sections a:hover,
	.sections a:focus-visible {
		color: var(--sl-color-white);
	}
	@media (max-width: 24rem) {
		.site-title {
			font-size: 1.25rem;
		}
	}
</style>
