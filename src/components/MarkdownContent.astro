---
// Override of Starlight's MarkdownContent: the one-sentence answer above the page body,
// and the page notes (scope, caveat, date, sources) after it, all in the same
// container as the body. Extractors that keep only the main article (Readability and
// the like) would drop them anywhere else.
// The same frontmatter fields also produce the Markdown twin (src/lib/page-md.mjs)
// and the JSON-LD (src/routeData.ts).
import '@astrojs/starlight/style/markdown.css';
import { SITE, LABELS, LOCALES, pageId, localeOf, mdPath, llmsPath, withBase, isoDate } from '../lib/site.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const id = pageId(Astro.locals.starlightRoute.entry.id);
const locale = localeOf(id);
const t = LABELS[locale.lang];
// Starlight's built-in 404 page has no contract fields. It gets links to the home page
// and the page list instead, so a wrong URL is not a dead end.
const hasFacts = Boolean(data.lastVerified && data.sources);
// A note for agents that read the HTML: the scope and the caveat (shown to people after
// the body, repeated here so that they fall within the first 5,000 extracted characters),
// and where the Markdown is. It is hidden with a CSS class (not `hidden` or `aria-hidden`, which extractors
// treat as "drop this").
const agentNote = hasFacts
	? `${t.appliesTo}：${data.appliesTo}。${t.caveat}：${data.caveat} Markdown：${SITE}${mdPath(id)} 。所有頁面：${SITE}${llmsPath(locale)} 、${SITE}/index.json 。`
	: '';
---

<div class="sl-markdown-content">
{/* No wrapper around the note, the answer and the page notes: as direct children of
     the article container they make it the element a readability-style extractor
     keeps, together with the body. */}
{hasFacts && <>
<p class="not-content agent-note">{agentNote}</p>
<p class="not-content answer">{data.description}</p>
</>}
{!hasFacts && <div class="not-content not-found">
<p>找不到這一頁。網址全部小寫，並以斜線結尾，例如 <code>/learn/prompting/</code>。</p>
<ul>
	{LOCALES.map((l) => (
		<li>
			<a href={withBase(l.dir ? `/${l.dir}/` : '/')}>{t.home}</a>、<a href={withBase(llmsPath(l))}>{t.pageList}</a>
		</li>
	))}
</ul>
</div>}
<slot />
{/* Page notes after the body. */}
{hasFacts && <dl class="not-content facts">
	<dt>{t.appliesTo}</dt>
	<dd>{data.appliesTo}</dd>
	<dt>{t.caveat}</dt>
	<dd>{data.caveat}</dd>
	<dt>{t.lastVerified}</dt>
	<dd><time datetime={isoDate(data.lastVerified)}>{isoDate(data.lastVerified)}</time></dd>
	<dt>{t.sources}</dt>
	<dd>
		<ul>
			{data.sources.map((source) => <li><a href={source.url}>{source.title}</a></li>)}
		</ul>
	</dd>
	<dt>{t.markdown}</dt>
	<dd><a href={withBase(mdPath(id))}>{mdPath(id)}</a></dd>
</dl>}
</div>

<style>
	.agent-note {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.not-found {
		margin-top: 1.5rem;
	}
	/* The subtitle under the title, then the rule that the official docs draw before the body. */
	.answer {
		margin-top: 0;
		margin-bottom: 3rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		padding-bottom: 3.5rem;
		color: var(--st-color-subtitle);
		font-size: 1.25rem;
		line-height: 1.6;
	}
	.answer + :global(*) {
		margin-top: 0;
	}
	.facts {
		display: grid;
		grid-template-columns: minmax(5.5rem, max-content) 1fr;
		gap: 0.35rem 1.25rem;
		margin-top: 4rem;
		margin-bottom: 0.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-sm);
		line-height: 1.7;
	}
	dt {
		color: var(--sl-color-gray-3);
	}
	dd {
		margin: 0;
		min-width: 0;
		overflow-wrap: anywhere;
		color: var(--sl-color-text);
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		color: var(--sl-color-text-accent);
	}
	@media (max-width: 36rem) {
		.facts {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}
		dd {
			margin-bottom: 0.5rem;
		}
	}
</style>
